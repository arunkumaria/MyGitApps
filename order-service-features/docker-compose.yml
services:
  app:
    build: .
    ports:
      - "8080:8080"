version: '3.8'

services:

  mysql:
    image: mysql:8
    container_name: mysql-container

    environment:
      MYSQL_ROOT_PASSWORD: root
      MYSQL_DATABASE: order_db

    ports:
      - "3306:3306"

  order-service:
    build: .
    container_name: order-service-container

    ports:
      - "8080:8080"

    depends_on:
      - mysql
